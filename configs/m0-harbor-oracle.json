{
  "job_name": "m0-harbor-oracle",
  "jobs_dir": "artifacts/m0/harbor",
  "n_attempts": 1,
  "n_concurrent_trials": 1,
  "retry": {"max_retries": 0},
  "agents": [{"name": "oracle"}],
  "environment": {
    "type": "daytona",
    "delete": true,
    "cpu_enforcement_policy": "guarantee",
    "memory_enforcement_policy": "guarantee",
    "override_cpus": 1,
    "override_memory_mb": 1024,
    "override_storage_mb": 3072,
    "override_gpus": 0,
    "kwargs": {
      "auto_stop_interval_mins": 1,
      "auto_delete_interval_mins": 0,
      "expose_sandbox_id": true
    }
  },
  "tasks": [{
    "path": "examples/tasks/hello-world",
    "git_url": "https://github.com/harbor-framework/harbor.git",
    "git_commit_id": "4407eb5227a2ff4f0d3f16b2eb48849382fdf276"
  }]
}
